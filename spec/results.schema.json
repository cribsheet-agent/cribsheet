{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cribsheet.pro/spec/results.schema.json",
  "title": "Cribsheet graded hour (draft)",
  "type": "object",
  "required": ["hour", "start_block", "end_block", "level", "model", "questions", "status"],
  "properties": {
    "hour": { "type": "integer", "minimum": 0, "description": "Exam number, 0 is the first hour." },
    "status": { "enum": ["graded", "missed"] },
    "missed_reason": { "type": "string" },
    "start_block": { "type": "integer" },
    "end_block": { "type": "integer" },
    "level": { "type": "integer", "minimum": 1, "maximum": 4 },
    "model": { "type": "string" },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "level", "text", "key", "answers"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "level": { "type": "integer" },
          "official": { "type": "boolean", "description": "false for extra lesson-test questions" },
          "text": { "type": "string" },
          "key": { "type": "string" },
          "key_sources": { "type": "array", "items": { "type": "string" } },
          "key_calls": { "type": "array", "items": { "type": "string" } },
          "answers": {
            "type": "object",
            "propertyNames": { "enum": ["blank", "manual", "self", "crowd"] },
            "additionalProperties": {
              "type": "object",
              "required": ["answer", "correct", "calls"],
              "properties": {
                "answer": { "type": ["string", "null"] },
                "correct": { "type": "boolean" },
                "calls": { "type": "integer" }
              }
            }
          }
        }
      }
    },
    "dropped": {
      "type": "array",
      "description": "Questions dropped because the two key readings disagreed.",
      "items": { "type": "object", "required": ["id", "reason"], "properties": { "id": { "type": "string" }, "reason": { "type": "string" } } }
    },
    "notes_kept": {
      "type": "string",
      "description": "Present only when Self's notes rewrite failed (for example an empty reply) and Self keeps its previous notes for the next hour."
    },
    "seal_tx": { "type": "string" }
  }
}
